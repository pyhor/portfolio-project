# Server-only configuration: add these in Vercel project environment settings,
# or copy this file to server/.env for the standalone Express server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use a sender address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.example>
# Exact origins only, comma-separated, no paths or trailing slash.
# Include your live frontend and localhost only when needed for development.
CONTACT_ALLOWED_ORIGINS=https://your-portfolio.example,http://localhost:5173
PORT=3001
# Optional existing GitHub proxy credential, unrelated to contact delivery.
GITHUB_TOKEN=
